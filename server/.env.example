# Copy this file to server/.env. It contains deployment settings only;
# Application secrets are split by service under server/secrets/.
COMPOSE_PROJECT_NAME=ai-cctv
AI_CCTV_VERSION=0.3.0

# Paths are resolved relative to server/ by Docker Compose. Forward-slash
# absolute paths such as D:/AI_CCTV/runtime are supported by Docker Desktop.
CONFIG_FILE=./config/config.yaml
DATA_SECRETS_FILE=./secrets/data.env
EXTERNAL_SECRETS_FILE=./secrets/external.env
INFERENCE_SECRETS_FILE=./secrets/inference.env
MEDIA_SECRETS_FILE=./secrets/media.env
# Legacy SECRETS_FILE/INTERNAL_CLIENT_SECRETS_FILE deployments are rejected by
# doctor because they expose unrelated secrets across service boundaries.
RECORDINGS_DIR=./runtime/recordings
RECOVERED_DIR=./runtime/recovered
DATABASE_DIR=./runtime/database
SNAPSHOTS_DIR=./runtime/snapshots
MODELS_DIR=./runtime/models
MODEL_FILE=default.pt
LOGS_DIR=./runtime/logs
CERTS_DIR=./runtime/certificates

# Keep the central recording writer and MediaMTX segment duration identical.
RECORDING_SEGMENT_SECONDS=60

# Linux bind mounts are created by this Host user. Docker Desktop accepts the
# same defaults; Configurator may replace them for a specific installation.
AI_CCTV_UID=1000
AI_CCTV_GID=1000

# Bind public HTTP/HTTPS as required for the selected deployment. Keep the
# loopback defaults until the firewall, TLS certificate and router are ready.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# Set this to the central server's trusted-LAN address for Raspberry Pi input.
# Never bind RTSP to an Internet-facing interface.
RTSP_BIND_ADDRESS=127.0.0.1
RTSP_PORT=8554

# Versioned images only. Update these values through a tested release.
MEDIAMTX_UPSTREAM_IMAGE=bluenviron/mediamtx:1.9.0
MEDIAMTX_WRAPPER_BASE_IMAGE=alpine:3.20.3
NGINX_IMAGE=nginx:1.27.2-alpine

# External-service policy (not secrets).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
PUBLIC_BASE_URL=https://cctv.example.com
EDGE_STATUS_POLL_INTERVAL_SECONDS=5
EDGE_CONTROL_TIMEOUT_SECONDS=75
EDGE_STATUS_TIMEOUT_SECONDS=5
MEDIA_CONTROL_TIMEOUT_SECONDS=5
EDGE_EVENT_PAGE_LIMIT=100
BATTERY_LOW_PERCENT=20
BATTERY_CRITICAL_PERCENT=10
STORAGE_WARNING_PERCENT=85
STORAGE_CRITICAL_PERCENT=95
RECOVERY_POLL_INTERVAL_SECONDS=5
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_RETRY_BASE_SECONDS=30
RECOVERY_SETTLE_SECONDS=15
RECOVERY_TIMEOUT_SECONDS=30
