# server/.env로 복사한다. 비밀값은 server/secrets/의 서비스별 파일에 둔다.
COMPOSE_PROJECT_NAME=ai-cctv
AI_CCTV_VERSION=0.3.0

# 경로는 server/ 기준이다. Docker Desktop에서는 D:/AI_CCTV/runtime 같은 절대 경로도 가능하다.
CONFIG_FILE=./config/config.yaml
DATA_SECRETS_FILE=./secrets/data.env
EXTERNAL_SECRETS_FILE=./secrets/external.env
PREPROCESSING_SECRETS_FILE=./secrets/preprocessing.env
ANALYSIS_SECRETS_FILE=./secrets/analysis.env
MEDIA_SECRETS_FILE=./secrets/media.env
# 비밀값을 한 파일로 공유하는 이전 배포 방식은 doctor가 거부한다.
RECORDINGS_DIR=./runtime/recordings
RECOVERED_DIR=./runtime/recovered
DATABASE_DIR=./runtime/database
SNAPSHOTS_DIR=./runtime/snapshots
MODELS_DIR=./runtime/models
MODEL_FILE=default.pt
LOGS_DIR=./runtime/logs
CERTS_DIR=./runtime/certificates

# 녹화 구간 길이는 Data와 MediaMTX에 동일하게 적용한다.
RECORDING_SEGMENT_SECONDS=60

# Linux 저장소 소유자의 UID/GID이며 Docker Desktop도 같은 기본값을 사용한다.
AI_CCTV_UID=1000
AI_CCTV_GID=1000

# 방화벽·인증서·공유기 설정을 마친 뒤 공개 주소를 지정한다.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# 실제 Edge 입력에는 신뢰하는 LAN 주소를 지정하며 RTSP를 인터넷에 공개하지 않는다.
RTSP_BIND_ADDRESS=127.0.0.1
RTSP_PORT=8554

# 이미지 버전은 검증한 릴리스로만 변경한다.
MEDIAMTX_UPSTREAM_IMAGE=bluenviron/mediamtx:1.9.0
MEDIAMTX_WRAPPER_BASE_IMAGE=alpine:3.20.3
NGINX_IMAGE=nginx:1.27.2-alpine

# External 동작 설정: 비밀값은 포함하지 않는다.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
PUBLIC_BASE_URL=https://cctv.example.com
EDGE_STATUS_POLL_INTERVAL_SECONDS=5
EDGE_CONTROL_TIMEOUT_SECONDS=75
EDGE_STATUS_TIMEOUT_SECONDS=5
MEDIA_CONTROL_TIMEOUT_SECONDS=5
EDGE_EVENT_PAGE_LIMIT=100
BATTERY_LOW_PERCENT=20
BATTERY_CRITICAL_PERCENT=10
STORAGE_WARNING_PERCENT=85
STORAGE_CRITICAL_PERCENT=95
RECOVERY_POLL_INTERVAL_SECONDS=5
RECOVERY_MAX_ATTEMPTS=3
RECOVERY_RETRY_BASE_SECONDS=30
RECOVERY_SETTLE_SECONDS=15
RECOVERY_TIMEOUT_SECONDS=30

# 감지·인물 식별·추가 분석 구현체의 모듈경로:팩토리.
DETECTION_PLUGIN=server.services.preprocessing.processors.detection.yolo:YoloTracker
IDENTITY_PLUGIN=server.services.preprocessing.processors.identity:LocalAppearanceIdentity
ANALYSIS_PLUGIN=server.services.analysis.processors:LocalAppearanceAnalyzer
# 비워 두면 CPU 외형 특징을 사용한다. ONNX 사용 시 컨테이너의 /models/... 경로를 지정한다.
IDENTITY_MODEL_PATH=
# 인물 연결·분석의 모델 호출/초기화 상한(초). 추론은 Data의 5분 임대보다 짧아야 한다.
OBJECT_MODEL_TIMEOUT_SECONDS=120
OBJECT_STARTUP_TIMEOUT_SECONDS=30
RTSP_TIMEOUT_SECONDS=5
MODEL_RETRY_SECONDS=30
DETECTION_SHUTDOWN_SECONDS=15
# 스냅샷 저장소의 영구 발송함 한도. 큐가 가득 차면 카메라별 추가 탐지를 대기시킨다.
EVENT_OUTBOX_MAX_PENDING=10000
EVENT_OUTBOX_MAX_BYTES=67108864
