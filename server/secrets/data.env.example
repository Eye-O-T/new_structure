# Data Service only. Each token must contain 32+ random characters, match the
# corresponding consumer file, and differ from every other scoped token.
DATA_EXTERNAL_TOKEN=replace-with-a-random-external-data-token
DATA_INFERENCE_TOKEN=replace-with-a-random-inference-data-token
DATA_MEDIA_TOKEN=replace-with-a-random-media-data-token
DATA_RECOVERY_TOKEN=replace-with-a-random-recovery-data-token
EDGE_AUTH_TOKENS_JSON='{"edge-001":"replace-with-at-least-32-random-characters"}'
