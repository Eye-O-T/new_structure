# External Service only. Generate real values; do not commit them.
# DATA_EXTERNAL_TOKEN must match only the value in data.env.
DATA_EXTERNAL_TOKEN=replace-with-a-random-external-data-token
JWT_SECRET=replace-with-at-least-256-bits-of-random-data
# Dedicated MediaMTX reader shared only with inference.env.
MEDIA_READ_USERNAME=inference-reader
MEDIA_READ_PASSWORD=replace-with-at-least-32-random-characters
# Bootstrap-only static credentials. Operational rotation is DB-backed and must
# use the authenticated server rotation API, not generate_secrets --camera-id.
MEDIA_PUBLISH_CREDENTIALS_JSON='{"cam-001":{"username":"cam-001","password":"replace-with-a-random-password"}}'
