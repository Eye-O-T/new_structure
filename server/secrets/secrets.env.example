# Generate server/secrets/secrets.env with scripts/generate_secrets.py.
# Do not deploy these placeholder values and do not commit the generated file.
JWT_SECRET=replace-with-at-least-256-bits-of-random-data
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token
# Compatibility alias for the current Data Service. It must equal
# INTERNAL_SERVICE_TOKEN and will be removed after configuration migration.
DATA_INTERNAL_TOKEN=replace-with-the-same-random-internal-service-token
MEDIA_PUBLISH_CREDENTIALS_JSON='{"cam-001":{"username":"edge-cam-001","password":"replace-with-a-random-password"}}'
