# Legacy direct-development combined-file example. Docker Compose rejects this
# layout; deployed systems use data.env, external.env, inference.env, and
# media.env generated by scripts/generate_secrets.py.
# Do not deploy these placeholder values and do not commit the generated file.
JWT_SECRET=replace-with-at-least-256-bits-of-random-data
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token
# Legacy Data Service alias. It must equal INTERNAL_SERVICE_TOKEN.
DATA_INTERNAL_TOKEN=replace-with-the-same-random-internal-service-token
EDGE_AUTH_TOKENS_JSON='{"edge-001":"replace-with-at-least-32-random-characters"}'
# Dedicated RTSP reader shared only by External and Inference when running the
# services directly without the split Compose secret files.
MEDIA_READ_USERNAME=inference-reader
MEDIA_READ_PASSWORD=replace-with-at-least-32-random-characters
# Bootstrap-only static credentials; this file cannot rotate DB-backed values.
MEDIA_PUBLISH_CREDENTIALS_JSON='{"cam-001":{"username":"cam-001","password":"replace-with-a-random-password"}}'
