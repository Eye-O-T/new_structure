# 배포용 .env 또는 compose.env와 같은 폴더에 push.env로 저장한다.
# 중앙 설정을 다시 생성해도 푸시 설정을 유지하도록 분리한다.
PUSH_ENABLED=true
FIREBASE_PROJECT_ID=your-existing-firebase-project-id
# External이 읽을 수 있는 호스트 절대 경로다. 실제 JSON은 Git에 넣지 않는다.
FIREBASE_SERVICE_ACCOUNT_FILE='C:/ProgramData/AI_CCTV/secrets/firebase-service-account.json'
