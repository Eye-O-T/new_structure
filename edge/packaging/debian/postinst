#!/bin/sh
# Debian이 파일 배치를 마친 뒤 실행하는 설치 후 처리다.
# 전용 계정·Python 환경·데이터 권한을 준비하되 최초 설치만으로 영상 전송을 시작하지 않는다.
set -eu

# 관리자 계정으로 상시 실행하지 않도록 전용 서비스 계정을 만들고 카메라 장치 접근 권한을 준다.
if ! getent group ai-cctv-edge >/dev/null; then
    addgroup --system ai-cctv-edge
fi
if ! getent passwd ai-cctv-edge >/dev/null; then
    adduser --system --ingroup ai-cctv-edge --home /var/lib/ai-cctv-edge \
        --no-create-home --disabled-login ai-cctv-edge
fi
usermod -a -G video ai-cctv-edge || true
if getent group render >/dev/null; then
    usermod -a -G render ai-cctv-edge || true
fi

# Python 의존성은 전용 가상환경에 설치한다. OS가 제공하는 카메라·GStreamer 관련
# 바인딩도 읽을 수 있도록 system-site-packages를 허용한다.
python3 -m venv --system-site-packages /usr/lib/ai-cctv-edge/venv
set -- /usr/lib/ai-cctv-edge/wheels/ai_cctv_edge-*.whl
if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
    echo "Expected exactly one bundled ai-cctv-edge wheel." >&2
    exit 1
fi
# no-index로 인터넷 패키지 저장소를 조회하지 않고 패키지에 포함된 wheel만 사용한다.
/usr/lib/ai-cctv-edge/venv/bin/pip install --no-index --force-reinstall \
    --find-links /usr/lib/ai-cctv-edge/wheels "$1"

# 녹화와 상태 저장소는 서비스 계정이 쓰고 다른 일반 사용자는 접근하지 못하도록 제한한다.
install -d -m 0750 -o ai-cctv-edge -g ai-cctv-edge \
    /var/lib/ai-cctv-edge/recordings /var/lib/ai-cctv-edge/state
chown root:ai-cctv-edge /etc/ai-cctv-edge
chmod 0750 /etc/ai-cctv-edge
if [ ! -s /etc/ai-cctv-edge/recovery.token ]; then
    # 기존 토큰은 보존한다. 새 토큰은 임시 파일의 기록·권한 설정을 마친 뒤 교체한다.
    umask 0077
    token_temp=$(mktemp /etc/ai-cctv-edge/.recovery.token.XXXXXX)
    trap 'rm -f "$token_temp"' EXIT INT TERM
    python3 -c 'import secrets; print(secrets.token_urlsafe(48))' \
        > "$token_temp"
    chown root:ai-cctv-edge "$token_temp"
    chmod 0640 "$token_temp"
    mv -f "$token_temp" /etc/ai-cctv-edge/recovery.token
    trap - EXIT INT TERM
fi
chown root:ai-cctv-edge /etc/ai-cctv-edge/recovery.token
chmod 0640 /etc/ai-cctv-edge/recovery.token

# 구형 장치의 설정은 유지하되 네트워크 인터페이스가 없는 장치는 자동 완료 처리하지 않는다.
configured_marker=/etc/ai-cctv-edge/.configured
if [ -n "${2:-}" ] && [ -s /etc/ai-cctv-edge/publish.password ] && \
    grep -q '^\[network\]$' /etc/ai-cctv-edge/config.toml && \
    grep -q '^interface = ' /etc/ai-cctv-edge/config.toml && \
    [ ! -e "$configured_marker" ]; then
    marker_temp=$(mktemp /etc/ai-cctv-edge/.configured.XXXXXX)
    trap 'rm -f "$marker_temp"' EXIT INT TERM
    printf 'configured\n' > "$marker_temp"
    chown root:ai-cctv-edge "$marker_temp"
    chmod 0644 "$marker_temp"
    mv -f "$marker_temp" "$configured_marker"
    trap - EXIT INT TERM
fi

# systemd가 갱신된 서비스 정의를 다시 읽게 한다. 새 장치의 자동 시작 활성화는 초기 설정에서 한다.
systemctl daemon-reload
# Package files and configuration handling are complete. Clear the transition
# guard before the normal root startup preflight runs for restarted services.
rm -f /var/lib/ai-cctv-edge/repair/package-transition
if [ -n "${2:-}" ]; then
    # 구형 설정은 관리자가 NIC를 이관할 때까지 기존 프로세스를 건드리지 않는다.
    if grep -q '^\[network\]$' /etc/ai-cctv-edge/config.toml && \
        grep -q '^interface = ' /etc/ai-cctv-edge/config.toml; then
        active_file=/run/ai-cctv-edge-network/upgrade-active-units
        if [ -f "$active_file" ]; then
            systemctl start ai-cctv-edge-network.service
            while IFS= read -r unit; do
                case "$unit" in
                    ai-cctv-edge.service|ai-cctv-edge-control.service|ai-cctv-edge-recovery.service)
                        systemctl start "$unit" ;;
                esac
            done < "$active_file"
            rm -f "$active_file"
        elif systemctl is-active --quiet ai-cctv-edge-network.service; then
            systemctl restart ai-cctv-edge-network.service
            systemctl try-restart ai-cctv-edge.service \
                ai-cctv-edge-control.service ai-cctv-edge-recovery.service
        fi
    else
        echo "AI CCTV Edge network.interface must be configured before the services can be restarted." >&2
    fi
fi
