[Unit]
Description=AI_CCTV Edge network interface policy
After=local-fs.target
Requires=ai-cctv-edge-repair-recovery.service
After=ai-cctv-edge-repair-recovery.service
ConditionPathExists=/etc/ai-cctv-edge/.configured

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ai-cctv-edge --config /etc/ai-cctv-edge/config.toml apply-network-policy
User=root
Group=ai-cctv-edge
RuntimeDirectory=ai-cctv-edge-network
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/run/ai-cctv-edge-network

[Install]
WantedBy=multi-user.target
