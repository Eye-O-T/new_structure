# 인증된 설정 변경·상태 조회 API를 영상 수집과 별도 프로세스로 실행한다.
# 영상 프로세스가 멈춰도 관리 API를 통해 상태 확인과 제어를 계속할 수 있게 한다.
[Unit]
Description=AI_CCTV edge authenticated management and status API
After=network.target
# 패키지 설치만으로 실행하지 않고 장치 초기 설정 완료 표시가 있어야 시작한다.
ConditionPathExists=/etc/ai-cctv-edge/.configured

[Service]
Type=simple
User=ai-cctv-edge
Group=ai-cctv-edge
ExecStart=/usr/bin/ai-cctv-edge --config /etc/ai-cctv-edge/config.toml serve-control
# API 프로세스가 종료되면 다시 시작한다. 관리자가 systemctl stop한 경우에는 재시작하지 않는다.
Restart=always
RestartSec=3
TimeoutStopSec=15
RuntimeDirectory=ai-cctv-edge
RuntimeDirectoryPreserve=yes
StateDirectory=ai-cctv-edge
LogsDirectory=ai-cctv-edge
ConfigurationDirectory=ai-cctv-edge
# 전용 계정으로 실행하고 새 파일 권한·임시 폴더·홈 및 시스템 영역 접근을 제한한다.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
# 초기 설정이 서비스를 enable하면 다음 부팅부터 자동 실행 대상이 된다.
WantedBy=multi-user.target
