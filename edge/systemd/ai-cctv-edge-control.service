# 영상 수집이 멈춰도 상태 조회·제어를 제공하도록 관리 API를 별도 서비스로 실행한다.
[Unit]
Description=AI_CCTV edge authenticated management and status API
After=network.target
# 패키지 설치만으로 실행하지 않고 장치 초기 설정 완료 표시가 있어야 시작한다.
ConditionPathExists=/etc/ai-cctv-edge/.configured

[Service]
Type=simple
User=ai-cctv-edge
Group=ai-cctv-edge
ExecStart=/usr/bin/ai-cctv-edge --config /etc/ai-cctv-edge/config.toml serve-control
# 종료된 API를 재시작한다. 관리자의 systemctl stop 요청에는 적용하지 않는다.
Restart=always
RestartSec=3
TimeoutStopSec=15
RuntimeDirectory=ai-cctv-edge
RuntimeDirectoryPreserve=yes
StateDirectory=ai-cctv-edge
LogsDirectory=ai-cctv-edge
ConfigurationDirectory=ai-cctv-edge
# 전용 계정으로 실행하고 새 파일 권한·임시 폴더·홈 및 시스템 영역 접근을 제한한다.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
